# --- En Railway: NO hace falta llenar las de arriba ---
# Railway inyecta automáticamente MYSQLHOST, MYSQLPORT, MYSQLUSER,
# MYSQLPASSWORD y MYSQLDATABASE cuando enlazas el servicio de MySQL
# (variables tipo "${{MySQL.MYSQLHOST}}"). config/db.js ya las detecta solo.

JWT_SECRET=cambia_esta_clave_por_una_segura
JWT_EXPIRES_IN=8h

# En Railway, apunta esto al dominio público del servicio frontend, ej:
# CORS_ORIGIN=https://${{frontend.RAILWAY_PUBLIC_DOMAIN}}
CORS_ORIGIN=http://localhost:5173
